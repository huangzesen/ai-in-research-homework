<?xml version="1.0" encoding="utf-8"?>
<Task xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task" version="1.3">
  <!-- Sanitized export of the real installed task. Owner SID and absolute user paths are placeholders. Use install-windows.ps1 to register on another computer. --><RegistrationInfo>
    <Description>Week 5 event-driven research agent; phone controls and budgets enforced in code.</Description>
    <URI>\JasminesAgent-AlwaysOn</URI>
  </RegistrationInfo>
  <Principals>
    <Principal id="Author">
      <UserId>OWNER_SID</UserId>
      <LogonType>InteractiveToken</LogonType>
    </Principal>
  </Principals>
  <Settings>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <Priority>5</Priority>
    <RestartOnFailure>
      <Count>999</Count>
      <Interval>PT1M</Interval>
    </RestartOnFailure>
    <StartWhenAvailable>true</StartWhenAvailable>
    <IdleSettings>
      <Duration>PT10M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
  </Settings>
  <Triggers>
    <LogonTrigger>
      <UserId>OWNER_SID</UserId>
    </LogonTrigger>
    <TimeTrigger>
      <StartBoundary>2026-11-02T23:09:46-08:00</StartBoundary>
      <Repetition>
        <Interval>PT1M</Interval>
        <StopAtDurationEnd>true</StopAtDurationEnd>
      </Repetition>
    </TimeTrigger>
  </Triggers>
  <Actions Context="Author">
    <Exec>
      <Command>C:\path\to\heliophysics-agent\.venv\Scripts\pythonw.exe</Command>
      <Arguments>"C:\path\to\heliophysics-agent\service_runner.py"</Arguments>
      <WorkingDirectory>C:\path\to\heliophysics-agent</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
